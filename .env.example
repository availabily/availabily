# ─── Demo mode ───────────────────────────────────────────────────────────────
# Set to "true" to run without Supabase or Resend.
# Uses in-memory data (resets on server restart). Visit /demo to preview.
NEXT_PUBLIC_DEMO_MODE=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://amorpm.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secrets. Two Stripe destinations point at /api/stripe/webhook:
#  - STRIPE_WEBHOOK_SECRET: the "Connected accounts" destination
#    (account.updated, invoice.paid, invoice.payment_failed, invoice.finalization_failed)
#  - STRIPE_WEBHOOK_SECRET_ACCOUNT: the "Your account" destination
#    (customer.subscription.created/updated/deleted, checkout.session.completed)
# The handler verifies against whichever secret matches.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_ACCOUNT=

# ─── Platform fee & owner subscription ────────────────────────────────────────
# Percent of each invoice the platform keeps. Owners on the $4.99/mo plan pay the
# "subscribed" rate; everyone else pays the "default" rate.
STRIPE_FEE_PERCENT_DEFAULT=7
STRIPE_FEE_PERCENT_SUBSCRIBED=4
# Stripe Price ID for the $4.99/mo "AM or PM? Pro" subscription (recurring, on the
# PLATFORM account). Required for the upgrade flow outside demo mode.
STRIPE_SUBSCRIPTION_PRICE_ID=

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=
